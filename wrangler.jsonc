// Cloudflare deploy config (Workers static assets). Build first: `node build.mjs`.
// Deploy manually with `npx wrangler deploy`, or connect the repo in the Cloudflare
// dashboard (Workers & Pages → Create → Import a repository) and it deploys on push.
{
  // Internal Worker name. Keep it: renaming creates a new Worker that conflicts with the existing route.
  "name": "shocktober",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /boo redirects to /boo/ so the page's relative links resolve under /boo/.
    "html_handling": "auto-trailing-slash"
  },
  // Serve only example.com/boo from this Worker; the rest of example.com is untouched.
  // Keep these in sync with siteUrl in event.config.mjs.
  "routes": [
    { "pattern": "example.com/boo", "zone_name": "example.com" },
    { "pattern": "example.com/boo/*", "zone_name": "example.com" }
  ]
}
